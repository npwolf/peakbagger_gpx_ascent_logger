{
  "name": "peakbagger_gpx_ascent_logger",
  "version": "1.0.0",
  "description": "Chrome extension to add ascent to Peakbagger",
  "main": "popup.js",
  "scripts": {
    "prepare": "husky install"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,scss,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.17.0",
    "eslint": "^8.57.1",
    "globals": "^15.14.0",
    "husky": "^8.0.3",
    "prettier": "^2.8.8"
  }
}
